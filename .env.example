# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Required ---------------------------------------------------------------

# Telegram bot token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN_NOTION=your-telegram-bot-token

# OpenAI API key — powers the CRUD/habit agent AND Whisper voice transcription.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Your Telegram numeric chat id (the owner, for failure alerts + digest).
# Comma-separate multiple ids. Ask @userinfobot for yours.
TELEGRAM_CHAT_ID=000000000

# --- Optional ---------------------------------------------------------------

# Chat model override (a sensible default is built in; set only to override).
# NOTION_MODEL=gpt-5.4-mini
