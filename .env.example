# Copy to `.env` in this directory and fill in real values. NEVER commit `.env`.
#
# If no `.env` exists here, config falls back to ~/.config/m1zz1/.env — that is
# how this bot runs alongside its siblings on the author's host. Either path
# works; the local one wins when present.

# --- Required ---------------------------------------------------------------

# Telegram bot token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN_NOTION=your-telegram-bot-token

# OpenAI API key — powers the task agent AND Whisper voice transcription.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Your Telegram numeric chat id: the owner. Receives the digest, the slot pings
# and the failure alerts, and is the only chat allowed to commit a plan.
# Comma-separate multiple ids. Ask @userinfobot for yours.
TELEGRAM_CHAT_ID=000000000

# --- Have defaults, listed because they change behaviour --------------------

# Ledgers for what was already announced, answered, committed and pinged. This
# is what makes a systemd restart a non-event rather than a second round of
# notifications. Without a reachable redis the bot still runs, but reminders
# degrade to at-most-once.
REDIS_URL=redis://localhost:6379

# A ZoneInfo name, never a fixed offset — the digest and the slot pings fire on
# a wall clock, so the zone has to carry its own DST.
TIMEZONE=Europe/Dublin

# Hour of the local day the digest is sent.
DIGEST_HOUR=11

# --- Optional ---------------------------------------------------------------

# Chat model override (a sensible default is built in; set only to override).
# NOTION_MODEL=gpt-5.4-mini
