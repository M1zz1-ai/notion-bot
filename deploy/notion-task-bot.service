# notion-task-bot systemd unit (TEMPLATE — not installed by this repo).
#
# Install (Linux host):
#   1. Edit User= and the WorkingDirectory/ExecStart paths below.
#   2. Create .env (chmod 600) with the required keys (see .env.example):
#      TELEGRAM_BOT_TOKEN_NOTION, OPENAI_API_KEY, TELEGRAM_CHAT_ID
#   3. Ensure `notion-cli` is installed and on PATH for the service User
#      (it owns Notion auth; see the README "Prerequisite: notion-cli").
#   4. cp deploy/notion-task-bot.service /etc/systemd/system/
#   5. systemctl daemon-reload && systemctl enable --now notion-task-bot
#
# Verify config before enabling:  uv run python -m notion --check
# Send one digest on a timer instead of the long-poll: ExecStart ... -m notion --digest-once

[Unit]
Description=notion-task-bot (Telegram -> LLM agent -> Notion task/habit CRUD)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/notion-task-bot
ExecStart=/home/CHANGE_ME/.local/bin/uv run python -m notion
Restart=on-failure
RestartSec=10
# The process survives transient OpenAI/Telegram/notion-cli errors on its own
# (core.errors resilience); Restart=on-failure only covers a hard exit (e.g. OOM).

[Install]
WantedBy=multi-user.target
